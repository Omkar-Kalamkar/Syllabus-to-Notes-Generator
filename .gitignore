# Private environment files
.env
.env.*
!.env.example

# Virtual environments
venv/
.venv/
env/
ENV/

# Python cache and compiled files
__pycache__/
*.py[cod]
*$py.class
.pytest_cache/
.mypy_cache/

# Streamlit secrets
.streamlit/secrets.toml

# Logs and OS files
*.log
.DS_Store
Thumbs.db
desktop.ini

# Generated screenshots (keep the folder with .gitkeep)
screenshots/*
!screenshots/.gitkeep
